{
  "name": "@tabliodb/server",
  "version": "0.1.0",
  "description": "NestJS API and realtime collaboration server for Tabliodb.",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "nest build",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/bin/migrate.ts",
    "db:reset": "tsx src/bin/reset-dev.ts",
    "db:seed": "tsx src/bin/seed-dev.ts",
    "db:fresh": "npm run db:reset && npm run db:seed",
    "openapi:sync": "tsx src/bin/sync-open-api.ts",
    "recovery": "tsx src/bin/recovery.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.4.0",
    "@hocuspocus/extension-redis": "^4.4.0",
    "@hocuspocus/server": "^4.4.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@tabliodb/schema-core": "file:../../packages/schema-core",
    "@tabliodb/shared": "file:../../packages/shared",
    "@tabliodb/sql": "file:../../packages/sql",
    "bcrypt": "^6.0.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.4",
    "kysely-postgres-js": "^3.0.0",
    "nestjs-kysely": "^3.1.2",
    "nestjs-zod": "^5.5.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  }
}

TABLIODB_IMAGE=tabliodb:local
TABLIODB_PORT=4000
TABLIODB_PUBLIC_URL=http://localhost:4000
TABLIODB_COOKIE_SECURE=false
TABLIODB_REALTIME_ENABLED=true
TABLIODB_REALTIME_PORT=1234
TABLIODB_RUN_MIGRATIONS=true
TABLIODB_MIGRATION_RETRIES=30
TABLIODB_BACKGROUND_JOBS_ENABLED=true
TABLIODB_BACKGROUND_JOB_BATCH_SIZE=10
TABLIODB_BACKGROUND_JOB_POLL_INTERVAL_MS=2500
TABLIODB_BACKGROUND_JOB_LOCK_TTL_MS=120000

POSTGRES_USER=tabliodb
POSTGRES_PASSWORD=change-this-password-before-production
POSTGRES_DB=tabliodb
